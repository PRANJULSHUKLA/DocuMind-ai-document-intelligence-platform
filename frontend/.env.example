VITE_API_BASE_URL=http://localhost:8000
# Private Vite development can override this with /api; production needs its deployed API URL.
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
# Set for providers that accept an audience query parameter, such as Auth0.
VITE_OIDC_AUDIENCE=
