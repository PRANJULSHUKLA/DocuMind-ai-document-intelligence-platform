# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=models/gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=full_rag

# Redis
REDIS_URL=redis://localhost:6379/0

# Identity: production requires a managed OIDC application issuing RS256 API tokens.
APP_ENV=development
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
# Optional override; otherwise resolved from trusted issuer discovery.
OIDC_JWKS_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared, private storage accessible to both API and worker.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
