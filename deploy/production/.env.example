# Copy to a private file OUTSIDE the checkout, mode 0600. Never commit actual values.
# This example is intentionally not runnable. Account/quota/OIDC gates are pending.
APP_ENV=production
AUTH_MODE=oidc
OIDC_ISSUER=https://your-verified-tenant.example/
OIDC_AUDIENCE=your-registered-api-audience
OIDC_JWKS_URL=
CORS_ORIGINS=https://your-reviewed-project.pages.dev
MONGODB_URI=
DATABASE_NAME=documind_pilot
GEMINI_API_KEY=
# Choose exact versions only after checking this key's project free-tier model quotas.
MODEL_NAME=
VISION_MODEL=
WORKFLOW_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MAX_RETRIES=0
GEMINI_FALLBACK_MODELS=
LANGSMITH_TRACING=false
UPLOAD_DIR=/srv/uploads
# Overrides in compose deliberately enforce local staging mode and limits.
REDIS_URL=redis://queue:6379/0
